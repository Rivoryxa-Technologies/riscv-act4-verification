*******************************************************************************************
* Values of the CV_SW_* variables:
*******************************************************************************************
CV_SW_TOOLCHAIN = /opt/riscv
CV_SW_PREFIX = riscv64-unknown-elf-
CV_SW_MARCH = rv32imc_zicsr_zifencei
CV_SW_CC = gcc
*******************************************************************************************
* Values of the RISCV_* variables:
*******************************************************************************************
RISCV            = /opt/riscv
RISCV_PREFIX     = riscv64-unknown-elf-
RISCV_EXE_PREFIX = /opt/riscv/bin/riscv64-unknown-elf-
RISCV_MARCH      = rv32imc_zicsr_zifencei
RISCV_CC         = gcc
RISCV_CFLAGS     = 
*******************************************************************************************
* Cloning CV32E40P RTL model
*******************************************************************************************
if [ ! -d /repo/workspace/dv/core-v-cores/cv32e40p ]; then git clone https://github.com/openhwgroup/cv32e40p /repo/workspace/dv/core-v-cores/cv32e40p; cd /repo/workspace/dv/core-v-cores/cv32e40p; git checkout 360d272898d81806be3377193870dbf83a3ea79f    ; fi
*******************************************************************************************
* Compiling CORE TB and CV32E40P with Verilator
*******************************************************************************************
verilator --main --binary --cc --sv --exe --build \
	 \
	--top-module tb_top \
	/repo/workspace/dv/tb/core/tb_top.sv /repo/workspace/dv/tb/core/cv32e40p_dut_wrap.sv /repo/workspace/dv/tb/core/tb_riscv/riscv_rvalid_stall.sv /repo/workspace/dv/tb/core/tb_riscv/riscv_gnt_stall.sv /repo/workspace/dv/tb/core/mm_ram.sv /repo/workspace/dv/tb/core/dp_ram.sv \
	-f /repo/workspace/dv/core-v-cores/cv32e40p/cv32e40p_manifest.flist \
	--Mdir cobj_dir \
	-CFLAGS "-std=gnu++14 -O2" \
	-Wno-COMBDLY -Wno-MULTIDRIVEN -Wno-BLKANDNBLK -Wno-lint --Wno-UNOPTFLAT -Wno-MODDUP -Wno-WIDTHCONCAT -Wno-WIDTHEXPAND -Wno-WIDTHTRUNC  \
	 \
	-GFPU_EN=0
